{
  "name": "iobroker.dbtimetables",
  "version": "0.1.0",
  "description": "ioBroker Adapter für Abfahrtstafeln auf Basis der offiziellen DB Timetables API (developers.deutschebahn.com)",
  "author": {
    "name": "Christian Lerch",
    "email": "christian.lerch@softwareschmiede-lerch.de"
  },
  "contributors": [],
  "license": "MIT",
  "homepage": "https://github.com/aSilentSniper/ioBroker.dbtimetables",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aSilentSniper/ioBroker.dbtimetables.git"
  },
  "keywords": [
    "ioBroker",
    "Deutsche Bahn",
    "DB",
    "Timetables",
    "Abfahrtstafel"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.2.2",
    "fast-xml-parser": "^4.3.6"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.7.3",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/aSilentSniper/ioBroker.dbtimetables/issues"
  },
  "readmeFilename": "README.md"
}
