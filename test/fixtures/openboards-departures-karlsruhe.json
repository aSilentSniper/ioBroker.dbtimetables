   }
  ],
  "notes": [
   {
    "descriptions": [
     {
      "language": "deu",
      "text": "Zug fährt mit anderem Fahrzeug. Bordrestaurant/Bordbistro in Wagen 26. Fahrradstellplätze in Wagen 21. Rollstuhlgerechte Einrichtung in Wagen 25. Mobilitätseingeschränkte Reisende wenden sich bzgl. eventuell erforderlicher Umbuchungen an unsere Mobilitätsservice-Zentrale.",
      "textShort": "Anderes Fahrzeug. Bordrestaurant/Bordbistro Wagen 26. Fahrradstellplätze in Wagen 21. Rollstuhlgerechte Einrichtung in Wagen 25. Bei erforderlichen Umbuchungen an Mobilitätsservice-Zentrale wenden."
     },
     {
      "language": "eng",
      "text": "The train is operating with a different set of cars. The on-board restaurant/bistro is in car 26. Bicycle storage is available in car 21. Wheelchair-accessible facilities are available in car 25. Passengers with limited mobility should contact our Mobility Service Center regarding any necessary rebookings.",
      "textShort": "Different train. Onboard restaurant/bistro in car 26. Bicycle parking spaces in car 21. Wheelchair-accessible facilities in car 25. If you need to make changes to your reservation, please contact the Mobility Service Center."
     }
    ],
    "displayPriority": 60,
