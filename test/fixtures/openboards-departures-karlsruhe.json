    "descriptions": [
     {
      "language": "deu",
      "text": "Die Reparatur an der Strecke zwischen Offenbach(Main)Hbf und Frankfurt(Main)Süd ist beendet. Es kann noch zu Folgeverspätungen kommen. Bitte prüfen Sie Ihre Reiseverbindung kurz vor Abfahrt des Zuges.",
      "textShort": "Die Reparatur an der Strecke zwischen Offenbach(Main)Hbf und Frankfurt(Main)Süd ist beendet."
     },
     {
      "language": "eng",
      "text": "Repairs on the route between Offenbach (Main) Central Station and Frankfurt (Main) South have been completed. There may still be some residual delays. Please check your travel itinerary shortly before the train's departure.",
      "textShort": "Repairs on the section of track between Offenbach (Main) Central Station and Frankfurt (Main) South have been completed."
     }
    ],
    "displayPriority": 20,
    "disruptionCommunicationID": "11a04acf-64b8-49b0-a1b7-7da8ea469f1d",
